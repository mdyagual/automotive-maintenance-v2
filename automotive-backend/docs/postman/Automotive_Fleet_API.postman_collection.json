			"name": "10. Actualizar a 100k km (Critical Threshold)",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Pre-request: Crear vehículo para prueba de umbral crítico",
							"const baseUrl = pm.environment.get(\"baseUrl\");",
							"",
							"pm.sendRequest({",
							"    url: `${baseUrl}/vehicles`,",
							"    method: 'POST',",
							"    header: {",
							"        'Content-Type': 'application/json'",
							"    },",
							"    body: {",
							"        mode: 'raw',",
							"        raw: JSON.stringify({",
							"            \"id\": \"V-CRITICAL-TEST\",",
							"            \"plate\": \"CRT-999\",",
							"            \"model\": \"Test Critical\",",
							"            \"initial_mileage\": 95000",
							"        })",
							"    }",
							"}, function (err, response) {",
							"    if (!err && response.code === 201) {",
							"        pm.environment.set(\"criticalVehicleId\", \"V-CRITICAL-TEST\");",
							"        console.log(\"✅ Vehículo para prueba crítica creado\");",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test 1: Verificar código 200 OK",
							"pm.test(\"Status code es 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Test 2: Kilometraje actualizado a 100000 km",
							"pm.test(\"Kilometraje actualizado a 100000 km\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.current_mileage).to.eql(100000);",
							"});",
							"",
							"// Test 3: Verificar que se generaron múltiples alertas",
							"setTimeout(function() {",
							"    const baseUrl = pm.environment.get(\"baseUrl\");",
							"    pm.sendRequest(`${baseUrl}/vehicles/V-CRITICAL-TEST/alerts`, function (err, response) {",
							"        if (!err) {",
							"            const alerts = response.json();",
							"            ",
							"            pm.test(\"Se generaron múltiples alertas (Strategy Pattern)\", function () {",
							"                pm.expect(alerts.length).to.be.at.least(2);",
							"            });",
							"            ",
							"            pm.test(\"Existe alerta CRITICAL_THRESHOLD a 100000 km\", function () {",
							"                const criticalAlert = alerts.find(a => ",
							"                    a.alert_type === 'critical_threshold' && a.mileage === 100000",
							"                );",
							"                pm.expect(criticalAlert).to.not.be.undefined;",
							"            });",
							"            ",
							"            console.log(\"✅ Alertas generadas en umbral crítico:\", alerts.length);",
							"            console.log(\"Strategy Pattern verificado - Todas las estrategias funcionando\");",
							"        }",
							"    });",
							"}, 500);",
							""
						],
						"type": "text/javascript"
					}
				}
			],
